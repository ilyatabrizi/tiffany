# TIFFANY by Vanda — static PWA on cPanel/LiteSpeed.
# Every module is guarded: a host without one of these must not 500 the site.

Options -Indexes
DirectoryIndex index.html

# ---------------------------------------------------------------- MIME
# cPanel images often have no mapping for .webmanifest, which silently breaks
# "Add to Home Screen", and an unknown .woff2 gets downloaded instead of used.
<IfModule mod_mime.c>
  AddType application/manifest+json  .webmanifest
  AddType text/javascript            .js
  AddType font/woff2                 .woff2
  AddType image/webp                 .webp
  AddType video/mp4                  .mp4
  AddType video/webm                 .webm
  AddType image/svg+xml              .svg
  AddCharset UTF-8                   .html .css .js .webmanifest .json .svg
</IfModule>

# ------------------------------------------------------------ canonical
<IfModule mod_rewrite.c>
  RewriteEngine On

  # https, once the certificate is issued
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # one hostname, not two
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Crawlable addresses for search engines and AI answers (seo.php): a piece,
  # a collection, the whole shop, the sitemap and llms.txt. In a browser the
  # shop opens the same page from them (js/router.js).
  RewriteRule ^p/([a-z0-9][a-z0-9-]{1,60})/?$ seo.php?k=p&id=$1 [L]
  RewriteRule ^c/([a-z0-9][a-z0-9-]{1,60})/?$ seo.php?k=c&id=$1 [L]
  RewriteRule ^shop/?$ seo.php?k=shop [L]
  RewriteRule ^sitemap\.xml$ seo.php?k=sitemap [L]
  RewriteRule ^llms\.txt$ seo.php?k=llms [L]
</IfModule>

# -------------------------------------------------------------- caching
# The app is hash-routed; index.html (and seo.php's copies of it, which send
# their own headers) must never be held. sw.js must never be held either, or an update can never
# arrive. Fingerprint-free assets get a week and the worker revalidates them.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <Files "sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </Files>
  # Modules import each other by name, so a page must never mix an old file
  # from the browser's cache with a new one from a deploy: always revalidate
  # (a 304 costs next to nothing; the service worker does the same).
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|woff2|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ------------------------------------------------------------ security
# Never framed by another site, no camera or location, the microphone only
# for this site's own pages (voice notes in tickets), HTTPS only for six months
# once seen (the certificate renews itself through cPanel), and the PHP version
# is nobody's business.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=()"
  Header always set Strict-Transport-Security "max-age=15552000"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# ---------------------------------------------------------- compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript \
    application/javascript application/json application/manifest+json \
    image/svg+xml
</IfModule>

# The hero clip is streamed; byte ranges must survive.
<IfModule mod_headers.c>
  <FilesMatch "\.mp4$">
    Header set Accept-Ranges bytes
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
